{
  "name": "florilegium-reader",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-10",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/web/viewer.html", "/pdfs/*"]
  },
  "r2_buckets": [
    { "binding": "LIBRARY_BUCKET", "bucket_name": "sacrum-assets" }
  ],
  "observability": {
    "enabled": false
  }
}
