{
  "name": "florilegium-reader",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-10",
  "assets": {
    "directory": ".",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "ANNOTATION_BUCKET",
      "bucket_name": "sacrum-assets"
    }
  ],
  "observability": {
    "enabled": false
  }
}
